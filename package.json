{
  "name": "aws-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "up": "docker compose up -d && node scripts/wait-health.mjs",
    "provision": "node scripts/provision.mjs",
    "demo": "node scripts/demo.mjs",
    "logs": "node scripts/logs.mjs",
    "peek": "node scripts/peek.mjs",
    "pause": "node scripts/mapping.mjs pause",
    "resume": "node scripts/mapping.mjs resume",
    "invoke": "node scripts/invoke.mjs",
    "ui": "node scripts/serve.mjs",
    "down": "docker compose down --remove-orphans"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0"
  }
}
